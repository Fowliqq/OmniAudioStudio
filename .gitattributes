# Auto detect text files and perform LF normalization
* text=auto

# C# and .NET files use CRLF for Windows WPF compatibility
*.cs text eol=crlf
*.xaml text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.config text eol=crlf
*.json text eol=crlf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.exe binary
*.dll binary
*.zip binary

# GitHub Linguist Overrides (Force 100% C# in repository language bar)
*.ps1 linguist-detectable=false linguist-vendored=true
scripts/** linguist-detectable=false linguist-vendored=true
*.xaml linguist-detectable=false
*.xml linguist-detectable=false
*.json linguist-detectable=false
*.yml linguist-detectable=false
*.yaml linguist-detectable=false
